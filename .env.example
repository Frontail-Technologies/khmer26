# Base URL of the API, including /api/v1
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1

# Public site URL (metadata, share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin site URL. Use https://admin.khmer26.com in production.
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost:3000

# Social sign-in (leave empty to hide the button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_TELEGRAM_BOT_ID=

# Optional map tile style URL
NEXT_PUBLIC_MAP_TILE_URL=

# Public base URL of the media bucket (R2)
NEXT_PUBLIC_R2_PUBLIC_URL=
